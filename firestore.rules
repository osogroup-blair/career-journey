rules_version = '2';

// Every document this app writes lives under users/{uid}/... (see src/data/FirestoreDataStore.ts).
// Accounts are created via self-service sign-up (see src/components/AuthGate.tsx) — this rule
// keys off request.auth.uid so every authenticated account gets its own isolated data with no
// per-account rule changes needed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
