rules_version = '2';

// Every document this app writes lives under users/{uid}/... (see src/data/FirestoreDataStore.ts).
// This app is single-user by design — there is no sign-up flow, and exactly one account
// exists, created once via the Firebase Console. This rule still keys off request.auth.uid
// rather than a hardcoded uid so the schema stays multi-tenant-ready without changes here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
