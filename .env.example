# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional App URL
APP_URL="http://localhost:47293"

# --- Firebase (optional — leave all of these unset to keep running in local-only mode) ---
#
# Setting the VITE_FIREBASE_* vars switches the app from LocalStorageDataStore to
# FirestoreDataStore and puts it behind a sign-in screen (see src/lib/firebase.ts,
# src/components/AuthGate.tsx). Get these from the Firebase Console:
# Project Settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# FIREBASE_SERVICE_ACCOUNT_JSON: server-side only, never exposed to the client.
# Setting this switches on Firebase ID-token verification for /api/ai/* and
# /api/sources/* (see server/firebaseAdmin.ts). Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the entire downloaded JSON file as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional overrides for `npm run seed:demo` (server/scripts/seedDemo.ts).
# Leave unset to use the defaults: demo@career-journey.app / DemoPass123!
DEMO_EMAIL=""
DEMO_PASSWORD=""

# --- Billing / AI quota (payment-system-plan.md Phase 0 — optional, sensible defaults apply) ---
# Free plan's lifetime AI-action cap (never resets). Default: 20.
FREE_AI_ACTIONS_LIFETIME_LIMIT=""
# Pro Monthly's per-billing-period AI-action cap. Default: 100.
PRO_MONTHLY_AI_ACTIONS_LIMIT=""
# BYOM abuse-guard: max AI actions per user per 60s window. Default: 30.
BYOM_BURST_PER_MINUTE=""
# BYOM abuse-guard: max AI actions per user per 24h. Default: 500.
BYOM_DAILY_LIMIT=""
# Fallback flat daily cap used only when there's no verified uid or Firebase
# Admin isn't configured (local dev) — pre-existing behavior. Default: 50.
AI_DAILY_CALL_LIMIT=""

# --- Stripe (payment-system-plan.md Phase 1 — required for billing) ---
# From your Stripe Dashboard, Developers > API keys (test mode to start).
STRIPE_SECRET_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:47293/api/billing/webhook` locally,
# or Developers > Webhooks > your endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=""
# Price IDs (price_...) from the one Product with 3 recurring Prices you create
# in the Dashboard — see payment-system-plan.md Phase 1 step 3.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BYOM_MONTHLY=""
STRIPE_PRICE_BYOM_YEARLY=""

# --- Multi-provider AI verification (payment-system-plan.md Phase 3 — optional,
# only used by `npm run verify:ai`; the app itself only ever uses GEMINI_API_KEY
# for platform-key tiers. Real BYOM keys come from users, never from env vars. ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
